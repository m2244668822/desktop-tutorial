[Unit]
Description=Trevor private Graphiti sidecar
After=network-online.target ollama.service
Wants=network-online.target

[Service]
Type=simple
User=trevor
Group=trevor
WorkingDirectory=/opt/trevor/app/services/graphiti_sidecar
Environment=TREVOR_DEPLOYMENT=oci
Environment=TREVOR_DATA_DIR=/var/lib/trevor
Environment=TREVOR_GRAPHITI_HOST=127.0.0.1
Environment=TREVOR_GRAPHITI_PORT=8091
Environment=GRAPHITI_TELEMETRY_ENABLED=false
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=-/etc/trevor/trevor.env
LoadCredential=gemini_api_key:/etc/trevor/credentials/gemini_api_key
LoadCredential=graphiti_token:/etc/trevor/credentials/graphiti_token
ExecStart=/opt/trevor/app/services/graphiti_sidecar/.venv/bin/trevor-graphiti
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/trevor

[Install]
WantedBy=multi-user.target
