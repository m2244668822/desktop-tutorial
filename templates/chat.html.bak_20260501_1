        function escapeHtml(value) {
            return String(value ?? '')
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        function formatList(items) {
            if (!items || items.length === 0) return '<span class="empty-text">無</span>';
            return items.map(item => `<span class="tag">${escapeHtml(item)}</span>`).join('');
