        function getAgentMap(agents) {
            const map = new Map();
            (agents || []).forEach(agent => {
                if (agent && agent.key) {
                    map.set(agent.key, agent);
                }
            });
            return map;
        }

        function normalizeQuickAgents(agents) {
            const mergedIncoming = new Map();
            (agents || []).forEach(agent => {
                const normalizedKey = normalizeAgentKey(agent?.key || '');
                if (!normalizedKey) return;
                if (!mergedIncoming.has(normalizedKey)) {
                    mergedIncoming.set(normalizedKey, agent);
                }
            });
            return REQUIRED_AGENTS.map(agent => ({
                key: agent.key,
                label: mergedIncoming.get(agent.key)?.label || agent.label,
            }));
        }

        function renderQuickAgents(agents) {
            const normalizedAgents = normalizeQuickAgents(agents);
            agentQuickList.innerHTML = normalizedAgents.map(agent => `
                <div class="agent-mini-card">
                    <strong>${escapeHtml(agent.label)}</strong>
                    <small>${escapeHtml(agent.key)}</small>
                </div>
            `).join('');
        }

        function addMessage(sender, text, meta = {}) {
            const messageDiv = document.createElement('div');
            messageDiv.className = `message ${sender}`;

            const messageContent = document.createElement('div');
            messageContent.className = 'message-content';
            messageContent.textContent = text;
            messageDiv.appendChild(messageContent);

            const metaItems = [];
            if (meta.model) metaItems.push(`<span class="message-model">${escapeHtml(formatModelLabel(meta.model))}</span>`);
            if (meta.agent) metaItems.push(`<span class="message-agent">${escapeHtml(formatAgentLabel(meta.agent))}</span>`);
            if (meta.responseTime !== undefined && meta.responseTime !== null) {
                metaItems.push(`<span class="message-time">回應時間：${Number(meta.responseTime).toFixed(2)}s</span>`);
            }
            if (meta.signalTags && meta.signalTags.length) {
                metaItems.push(`<span class="message-tags">訊號標籤：${escapeHtml(meta.signalTags.join(', '))}</span>`);
            }

            if (metaItems.length) {
                const messageMeta = document.createElement('div');
                messageMeta.className = 'message-meta';
                messageMeta.innerHTML = metaItems.join('');
                messageDiv.appendChild(messageMeta);
            }

            chatBox.appendChild(messageDiv);
            chatBox.scrollTop = chatBox.scrollHeight;
        }

        function isTaskProgressNotification(item) {
            const category = String(item?.category || '').toLowerCase();
            const title = String(item?.title || '');
            return category === 'task' || category === 'sync' || /任務|同步|完成|失敗/.test(title);
        }

        function announceTaskProgressInChat(items) {
            if (!Array.isArray(items) || !items.length) return;
            const sorted = items
                .map(item => ({ ...item, _id: Number(item.notification_id || 0) }))
                .filter(item => item._id > latestTaskAnnouncementId)
                .sort((a, b) => a._id - b._id);

            sorted.forEach(item => {
                latestTaskAnnouncementId = Math.max(latestTaskAnnouncementId, item._id);
                if (!isTaskProgressNotification(item)) return;
                const agentKey = normalizeAgentKey(item.agent_key || 'general');
                const shortLabel = formatAgentLabel(agentKey).replace('智能體：', '');
                const status = item.level === 'error' ? '失敗' : (item.level === 'warning' ? '警示' : '更新');
                const line = `任務進度 [${shortLabel}] (${status}) ${item.title}：${item.message}`;
                addMessage('ai', line, { agent: agentKey });
            });
        }

        function renderNotifications(items, options = {}) {
            if (!items || !items.length) return;
            const announceToChat = Boolean(options.announceToChat);
            latestNotificationId = Math.max(latestNotificationId, ...items.map(item => Number(item.notification_id || 0)));
            const unreadCount = items.filter(item => !item.is_read).length;
            notificationBadge.textContent = String(unreadCount);
            notificationBadge.style.display = unreadCount > 0 ? 'inline-flex' : 'none';

            const cards = items.slice(-8).reverse().map(item => {
                const agentKey = normalizeAgentKey(item.agent_key || '');
                const shortLabel = formatAgentLabel(agentKey).replace('智能體：', '');
                return `
                <div class="notification-item ${escapeHtml(item.level || 'info')}">
                    <strong>[${escapeHtml(shortLabel)}] ${escapeHtml(item.title)}</strong>
                    <span>${escapeHtml(item.message)}</span>
                    <small>${escapeHtml(new Date(item.created_at).toLocaleTimeString('zh-TW'))}</small>
                </div>
            `;
            }).join('');
            notificationStrip.innerHTML = cards;
            if (announceToChat) {
                announceTaskProgressInChat(items);
            }
        }

        async function pullNotifications(showAll = false) {
            try {
                const query = showAll
                    ? `?limit=30`
                    : `?since_id=${encodeURIComponent(latestNotificationId)}&limit=30`;
                const response = await fetch(`/agent/notifications${query}`);
                const notifications = await response.json();
                if (Array.isArray(notifications) && notifications.length) {
                    renderNotifications(notifications, { announceToChat: !showAll });
                } else if (!notificationStrip.innerHTML) {
                    notificationStrip.innerHTML = '<div class="notification-empty">尚無即時通知</div>';
                }
            } catch (error) {
                if (!notificationStrip.innerHTML) {
                    notificationStrip.innerHTML = '<div class="notification-empty">通知服務暫時不可用</div>';
                }
            }
        }

