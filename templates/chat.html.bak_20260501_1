        function formatModelLabel(modelValue) {
            const value = String(modelValue || '').trim();
            const lower = value.toLowerCase();
            if (!value) return '模型：未知';
            if (lower.startsWith('local (')) return `模型：本地 ${value}`;
            if (lower.startsWith('openai')) return `模型：雲端 OpenAI（${value}）`;
            if (lower.startsWith('openrouter')) return `模型：雲端 OpenRouter（${value}）`;
            if (lower.startsWith('groq')) return `模型：雲端 Groq（${value}）`;
            if (lower.startsWith('gemini')) return `模型：雲端 Gemini（${value}）`;
            if (lower.startsWith('nvidia')) return `模型：雲端 NVIDIA（${value}）`;
            if (lower.startsWith('zhizengzeng') || lower.includes('智增增')) return `模型：雲端 智增增 ZZZ API（${value}）`;
            if (lower.includes('hugging face')) return `模型：雲端 Hugging Face（${value}）`;
            if (lower.includes('together')) return `模型：雲端 Together AI（${value}）`;
            if (lower.includes('gpt-2')) return `模型：本地 GPT-2（${value}）`;
            return `模型：${value}`;
        }

        function normalizeAgentKey(agentKey) {
            const key = String(agentKey || '').trim().toLowerCase();
            if (key === 'whitehat') return 'proclaimer';
            return key;
        }

        function formatAgentLabel(agentKey) {
            const key = normalizeAgentKey(agentKey);
            const map = {
                dispatcher: '總管中樞',
                general: '通用助理',
                xiaobian: '小編設計師',
                engineer: '工程師',
                researcher: '研究員',
                proclaimer: '申言者',
                learner: '學習器',
            };
            const zh = map[key] || key || '未分類';
            return `智能體：${zh}`;
        }

        function formatTimestamp(value) {
            if (!value) return '未知時間';
            const dt = new Date(value);
            if (Number.isNaN(dt.getTime())) return String(value);
            return dt.toLocaleString('zh-TW');
        }

        function saveInputDraft() {
            try {
                localStorage.setItem(INPUT_DRAFT_STORAGE_KEY, userInput.value || '');
            } catch (error) {
                // ignore storage failures
            }
        }

        function clearInputDraft() {
            try {
                localStorage.removeItem(INPUT_DRAFT_STORAGE_KEY);
            } catch (error) {
                // ignore storage failures
            }
        }

        function restoreInputDraft() {
            try {
                const draft = localStorage.getItem(INPUT_DRAFT_STORAGE_KEY) || '';
                if (draft && !userInput.value) {
                    userInput.value = draft;
                }
            } catch (error) {
                // ignore storage failures
            }
