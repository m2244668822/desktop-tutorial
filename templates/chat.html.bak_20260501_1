        async function sendMessage() {
            const message = userInput.value.trim();
            if (!message || isSending) return;

            hideWelcome();
            addMessage('user', message);
            userInput.value = '';
            clearInputDraft();
            updateCharCount();
            autoResizeInput();
            toggleSendButton();
            setSendInFlight(true);
            setInputHint('訊息送出中，系統正在分派智能體與等待回覆...');
            addTypingIndicator();

            try {
                const response = await fetchWithTimeout('/chat', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message, model: modelSelect.value })
                });
                const data = await response.json().catch(() => ({}));
                removeTypingIndicator();

                if (!response.ok) {
                    const errorMessage = data.error || `HTTP ${response.status}`;
                    addMessage('ai', `錯誤: ${errorMessage}`);
                    return;
                }

                if (data.error) {
                    addMessage('ai', `錯誤: ${data.error}`);
                    return;
                }

                const aiText = String(data.response || '').trim();
                if (!aiText) {
                    addMessage('ai', '系統已接收請求，但目前沒有有效回覆內容，請再送一次。');
                    return;
                }

                addMessage('ai', aiText, {
                    model: data.model,
                    agent: data.agent,
                    responseTime: data.response_time,
                    signalTags: data.signal_tags || []
                });
                setInputHint('總管會依關鍵詞與已學習訊號自動分派。');
                loadMonitorData(false);
            } catch (error) {
                removeTypingIndicator();
                if (error?.name === 'AbortError') {
                    addMessage('ai', '請求逾時（120 秒），你可以重送或拆小任務再試一次。');
                } else {
                    addMessage('ai', '網路錯誤，請重試。');
                }
            } finally {
                setSendInFlight(false);
                toggleSendButton();
            }
        }

