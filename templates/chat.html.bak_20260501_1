                    <option value="tinyllama">🏠 TinyLlama（本地備援）</option>
                    <option value="openai">☁️ OpenAI</option>
                    <option value="openrouter">☁️ OpenRouter (Free)</option>
                    <option value="groq">☁️ Groq</option>
                    <option value="gemini">☁️ Gemini</option>
                    <option value="zhizengzeng">☁️ 智增增 ZZZ API</option>
                    <option value="gpt2">🏠 GPT-2</option>
                    <option value="huggingface">☁️ Hugging Face</option>
                    <option value="together">☁️ Together AI</option>
                </select>
            </div>

            <div class="sidebar-section">
                <h3>功能</h3>
                <button class="sidebar-btn" id="status-btn">
                    <i class="fas fa-satellite-dish"></i>
                    即時監控
                </button>
                <button class="sidebar-btn" id="learn-btn">
                    <i class="fas fa-brain"></i>
                    自主學習
                </button>
                <button class="sidebar-btn" id="history-btn">
                    <i class="fas fa-history"></i>
                    聊天歷史
                </button>
            </div>

            <div class="sidebar-section">
