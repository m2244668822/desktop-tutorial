                    <i class="fas fa-paper-plane"></i>
                </button>
            </div>
            <div class="input-footer">
                <span class="char-count">0/2000</span>
                <span class="input-hint">總管會依關鍵詞與已學習訊號自動分派。</span>
            </div>
        </div>
