        async function startLearning() {
            learnBtn.disabled = true;
            learnBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> 學習中...';

            try {
                const response = await fetch('/learn', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                const data = await response.json();
                if (data.error) {
                    addMessage('ai', `學習錯誤: ${data.error}`);
                } else {
                    addMessage('ai', '自主學習完成，總管與學習器已更新訊號記憶。');
                    loadMonitorData(false);
                }
            } catch (error) {
                addMessage('ai', '學習失敗，請檢查網路連接。');
            } finally {
                learnBtn.disabled = false;
                learnBtn.innerHTML = '<i class="fas fa-brain"></i> 自主學習';
            }
        }

        async function loadMonitorData(showPanel = true) {
            if (showPanel) {
                openMonitorSidebar();
            }

            try {
                const [agentsRes, cnsRes, modelRes, signalRes, frameworkRes, securityRes] = await Promise.all([
                    fetch('/agents'),
                    fetch('/system/cns/status'),
                    fetch('/system/model-status'),
                    fetch('/agent/signals'),
                    fetch('/system/data-framework'),
                    fetch('/system/security-status')
                ]);

                const agents = await agentsRes.json();
                const cns = await cnsRes.json();
                const modelStatus = await modelRes.json();
                const signals = await signalRes.json();
                const framework = await frameworkRes.json();
                const security = await securityRes.json();

                renderQuickAgents(agents);
                applyModelAvailability(modelStatus);
                renderModelStatus(modelStatus);
                renderCnsStatus(cns);
                renderSecurityStatus(security);
                renderAgents(agents);
                renderSignals(signals);
                renderFramework(framework);
                renderOverview(modelStatus, cns, agents, signals, framework, security);
                monitorUpdatedAt.textContent = `更新時間 ${new Date().toLocaleTimeString('zh-TW')}`;
            } catch (error) {
                modelStatusPanel.innerHTML = '<div class="monitor-empty">無法載入監控資料</div>';
                securityStatusPanel.innerHTML = '<div class="monitor-empty">無法載入申言者安全守門資料</div>';
            }
        }

        function renderOverview(modelStatus, cns, agents, signals, framework, security) {
            const database = framework.database || {};
            const availableModels = [
                modelStatus.ollama_available,
                modelStatus.openai_key_configured,
                modelStatus.openrouter_key_configured,
                modelStatus.groq_key_configured,
                modelStatus.zhizengzeng_key_configured,
                modelStatus.huggingface_key_configured,
                modelStatus.together_key_configured,
                modelStatus.gpt2?.ml_runtime_available || modelStatus.gpt2?.sidecar_url
            ].filter(Boolean).length;
            const securityIndex = Number(security?.security_index ?? 0);
            const securityFindings = Number(security?.summary?.finding_count ?? 0);

            overviewMetricsPanel.innerHTML = `
                <article class="overview-metric-card">
                    <span>啟用智能體</span>
                    <strong>${escapeHtml(agents.length || 0)}</strong>
                    <small>中樞可分派節點</small>
                </article>
                <article class="overview-metric-card">
                    <span>模型通道</span>
                    <strong>${escapeHtml(availableModels)}</strong>
                    <small>可用或已設定的推理路徑</small>
                </article>
                <article class="overview-metric-card">
                    <span>訊號記憶</span>
                    <strong>${escapeHtml(signals.length || 0)}</strong>
                    <small>學習後的標籤詞條</small>
                </article>
                <article class="overview-metric-card">
                    <span>待追蹤資料</span>
                    <strong>${escapeHtml(database.chat_history_count || 0)}</strong>
                    <small>聊天歷史可供學習</small>
                </article>
                <article class="overview-metric-card">
                    <span>CNS 狀態</span>
                    <strong>${cns.enabled ? '啟用' : '停用'}</strong>
                    <small>${escapeHtml(cns.runtime?.last_cycle_summary || '尚無摘要')}</small>
                </article>
                <article class="overview-metric-card">
                    <span>API 安全指數</span>
                    <strong>${escapeHtml(`${securityIndex}/100`)}</strong>
                    <small>${escapeHtml(`${securityFindings} 項待追蹤問題`)}</small>
                </article>
                <article class="overview-metric-card">
                    <span>資料根目錄</span>
                    <strong>${framework.storage?.data_root?.exists ? '已掛載' : '待確認'}</strong>
                    <small>${escapeHtml(framework.storage?.data_root?.path || '')}</small>
                </article>
            `;
        }

        function renderModelStatus(data) {
            const gpt2 = data.gpt2 || {};
            const reasonRows = Object.entries(data.model_unavailable_reasons || {})
                .filter(([, reason]) => Boolean(reason))
                .map(([modelKey, reason]) => `<div class="metric-row"><span>${escapeHtml(modelKey)} 不可用原因</span><strong>${escapeHtml(reason)}</strong></div>`)
                .join('');
            modelStatusPanel.innerHTML = `
                <div class="metric-row"><span>Ollama</span><strong>${data.ollama_available ? '可用' : '不可用'}</strong></div>
                <div class="metric-row"><span>本地預設模型</span><strong>${escapeHtml(data.local_ollama_model || 'tinyllama')}</strong></div>
                <div class="metric-row"><span>GPT-2 後端</span><strong>${escapeHtml(gpt2.backend || '未知')}</strong></div>
                <div class="metric-row"><span>GPT-2 本地執行環境</span><strong>${gpt2.ml_runtime_available ? '可用' : '不可用'}</strong></div>
                <div class="metric-row"><span>GPT-2 副程序</span><strong>${escapeHtml(gpt2.sidecar_url || '未設定')}</strong></div>
                <div class="metric-row"><span>OpenAI 金鑰</span><strong>${data.openai_key_configured ? '已設定' : '未設定'}</strong></div>
                <div class="metric-row"><span>OpenAI 模型</span><strong>${escapeHtml(data.openai_model || '未設定')}</strong></div>
                <div class="metric-row"><span>OpenRouter 金鑰</span><strong>${data.openrouter_key_configured ? '已設定' : '未設定'}</strong></div>
                <div class="metric-row"><span>OpenRouter 金鑰槽</span><strong>${data.openrouter_key_configured ? escapeHtml(String(data.openrouter_key_slot || 1)) : '0'}</strong></div>
                <div class="metric-row"><span>OpenRouter 模型</span><strong>${escapeHtml(data.openrouter_model || '未設定')}</strong></div>
                <div class="metric-row"><span>Groq 金鑰</span><strong>${data.groq_key_configured ? '已設定' : '未設定'}</strong></div>
                <div class="metric-row"><span>Groq 模型</span><strong>${escapeHtml(data.groq_model || '未設定')}</strong></div>
                <div class="metric-row"><span>Gemini 金鑰</span><strong>${data.gemini_key_configured ? '已設定' : '未設定'}</strong></div>
                <div class="metric-row"><span>Gemini 模型</span><strong>${escapeHtml(data.gemini_model || '未設定')}</strong></div>
                <div class="metric-row"><span>NVIDIA 金鑰</span><strong>${data.nvidia_key_configured ? '已設定' : '未設定'}</strong></div>
                <div class="metric-row"><span>NVIDIA 模型</span><strong>${escapeHtml(data.nvidia_model || '未設定')}</strong></div>
                <div class="metric-row"><span>智增增 金鑰</span><strong>${data.zhizengzeng_key_configured ? '已設定' : '未設定'}</strong></div>
                <div class="metric-row"><span>智增增 模型</span><strong>${escapeHtml(data.zhizengzeng_model || '未設定')}</strong></div>
                <div class="metric-row"><span>Hugging Face 金鑰</span><strong>${data.huggingface_key_configured ? '已設定' : '未設定'}</strong></div>
                <div class="metric-row"><span>Together AI 金鑰</span><strong>${data.together_key_configured ? '已設定' : '未設定'}</strong></div>
                <div class="metric-row"><span>NotebookLM 連接器</span><strong>${data.notebooklm_enabled ? '啟用' : '停用'}</strong></div>
                <div class="metric-row"><span>NotebookLM 狀態</span><strong>${data.notebooklm_configured ? '可連線' : '待設定'}</strong></div>
                <div class="metric-row"><span>NotebookLM 專案/區域</span><strong>${escapeHtml(`${data.notebooklm_project_number || '未設定'} / ${data.notebooklm_location || 'global'}`)}</strong></div>
                ${reasonRows}
            `;
        }

        function renderSecurityStatus(data) {
            const summary = data.summary || {};
            const providerChecks = data.provider_checks || [];
            const findings = data.findings || [];

            const providerHtml = providerChecks.map(item => `
                <div class="metric-row">
                    <span>${escapeHtml(item.label)} (${escapeHtml(item.key)})</span>
                    <strong>${item.enabled ? (item.secure_transport ? '啟用且安全' : '啟用但有風險') : '未啟用'}</strong>
                </div>
            `).join('');

            const findingsHtml = findings.length
                ? findings.map(item => `
                    <div class="heartbeat-item">
                        <strong>${escapeHtml((item.severity || 'low').toUpperCase())} • ${escapeHtml(item.type || 'issue')}</strong>
                        <span>${escapeHtml(item.provider || 'system')}</span>
                        <small>${escapeHtml(item.message || '')}</small>
                    </div>
                `).join('')
                : '<div class="monitor-empty">目前未偵測到安全風險項目</div>';

            securityStatusPanel.innerHTML = `
                <div class="metric-row"><span>安全指數</span><strong>${escapeHtml(data.security_index || 0)}/100</strong></div>
                <div class="metric-row"><span>風險等級</span><strong>${escapeHtml(data.risk_level || '未知')}</strong></div>
                <div class="metric-row"><span>總問題數</span><strong>${escapeHtml(summary.finding_count || 0)}</strong></div>
                <div class="metric-row"><span>高風險問題</span><strong>${escapeHtml(summary.high_severity_count || 0)}</strong></div>
                <div class="metric-row"><span>中風險問題</span><strong>${escapeHtml(summary.medium_severity_count || 0)}</strong></div>
                <div class="metric-row"><span>檢查時間</span><strong>${escapeHtml(data.checked_at || '未知')}</strong></div>
                ${providerHtml}
                <div class="heartbeat-list">${findingsHtml}</div>
            `;
        }

        function renderCnsStatus(data) {
            const recentTasks = Array.isArray(data.recent_tasks) ? data.recent_tasks : [];
            const recentTaskNotifications = Array.isArray(data.recent_task_notifications) ? data.recent_task_notifications : [];
            const statusCount = recentTasks.reduce((acc, item) => {
                const key = String(item.status || 'pending').toLowerCase();
                acc[key] = (acc[key] || 0) + 1;
                return acc;
            }, {});

            const taskHtml = recentTasks.map(task => `
                <div class="heartbeat-item">
                    <strong>任務 #${escapeHtml(task.task_id)} • ${escapeHtml(task.title || '未命名任務')}</strong>
                    <span>${escapeHtml(task.status)} • ${escapeHtml(normalizeAgentKey(task.assigned_agent || 'general'))}</span>
                    <small>更新時間 ${escapeHtml(formatTimestamp(task.updated_at))}</small>
                </div>
            `).join('');

            const taskEventHtml = recentTaskNotifications.map(item => `
                <div class="heartbeat-item">
                    <strong>${escapeHtml(item.title || '任務更新')}</strong>
                    <span>${escapeHtml(normalizeAgentKey(item.agent_key || 'general'))} • ${escapeHtml(item.level || 'info')}</span>
                    <small>${escapeHtml(item.message || '')}</small>
                </div>
            `).join('');

            const heartbeatEnabled = Boolean(data.heartbeat_enabled);
            const heartbeatRows = (data.recent_heartbeats || []).map(beat => `
                <div class="heartbeat-item">
                    <strong>${escapeHtml(beat.cycle_type)}</strong>
                    <span>${escapeHtml(beat.status)}</span>
                    <small>${escapeHtml(beat.summary)}</small>
                </div>
            `).join('');

            cnsStatusPanel.innerHTML = `
                <div class="metric-row"><span>啟用狀態</span><strong>${data.enabled ? '啟用' : '停用'}</strong></div>
                <div class="metric-row"><span>巡檢間隔</span><strong>${escapeHtml(data.interval_seconds)}s</strong></div>
                <div class="metric-row"><span>背景執行緒</span><strong>${data.runtime.thread_started ? '已啟動' : '未啟動'}</strong></div>
                <div class="metric-row"><span>最後摘要</span><strong>${escapeHtml(data.runtime.last_cycle_summary || '無')}</strong></div>
                <div class="metric-row"><span>任務完成</span><strong>${escapeHtml(statusCount.completed || 0)}</strong></div>
                <div class="metric-row"><span>任務失敗</span><strong>${escapeHtml(statusCount.failed || 0)}</strong></div>
                <div class="heartbeat-list">${taskHtml || '<div class="monitor-empty">尚無任務紀錄</div>'}</div>
            `;
            cnsDetailPanel.innerHTML = `
                <div class="metric-row"><span>啟用狀態</span><strong>${data.enabled ? '啟用' : '停用'}</strong></div>
                <div class="metric-row"><span>巡檢間隔</span><strong>${escapeHtml(data.interval_seconds)} 秒</strong></div>
                <div class="metric-row"><span>背景執行緒</span><strong>${data.runtime.thread_started ? '已啟動' : '未啟動'}</strong></div>
                <div class="metric-row"><span>最後學習摘要</span><strong>${escapeHtml(data.runtime.last_cycle_summary || '無')}</strong></div>
                <div class="metric-row"><span>心跳記錄</span><strong>${heartbeatEnabled ? '啟用' : '停用'}</strong></div>
                <div class="metric-row"><span>最近任務數</span><strong>${escapeHtml(recentTasks.length)}</strong></div>
                <div class="heartbeat-list">${taskEventHtml || '<div class="monitor-empty">尚無任務事件</div>'}</div>
                ${heartbeatEnabled ? `<div class="heartbeat-list">${heartbeatRows}</div>` : ''}
            `;
        }

        function renderAgents(agents) {
            agentsPanel.innerHTML = agents.map(agent => `
                <article class="agent-card">
                    <div class="agent-card-head">
                        <h5>${escapeHtml(agent.label)}</h5>
                        <span>${escapeHtml(agent.key)}</span>
                    </div>
                    <p>${escapeHtml(agent.description)}</p>
                    <div class="agent-section-line"><strong>能力</strong>${formatCapabilities(agent.capabilities)}</div>
                    <div class="agent-section-line"><strong>訊號</strong>${formatList(agent.signal_tags)}</div>
                    <div class="agent-section-line"><strong>協作</strong>${formatList(agent.collaborators)}</div>
                    <div class="agent-section-line"><strong>主動工作</strong>${formatList(agent.proactive_jobs)}</div>
                </article>
            `).join('');
        }

        function renderSignals(signals) {
            if (!signals.length) {
                signalPanel.innerHTML = '<div class="monitor-empty">尚無學習到的訊號</div>';
                return;
            }

            signalPanel.innerHTML = signals.slice(0, 48).map(signal => `
                <div class="signal-chip">
                    <strong>${escapeHtml(signal.signal)}</strong>
                    <span>${escapeHtml(normalizeAgentKey(signal.agent_key))}</span>
                    <small>命中 ${escapeHtml(signal.hit_count)}</small>
                </div>
            `).join('');
        }

        function renderFramework(framework) {
            const storage = framework.storage || {};
            const database = framework.database || {};
            dataFrameworkPanel.innerHTML = `
                <div class="metric-row"><span>資料根目錄</span><strong>${escapeHtml(storage.data_root?.path || '')}</strong></div>
                <div class="metric-row"><span>資料庫路徑</span><strong>${escapeHtml(storage.database?.path || '')}</strong></div>
                <div class="metric-row"><span>聊天紀錄</span><strong>${escapeHtml(database.chat_history_count || 0)}</strong></div>
                <div class="metric-row"><span>任務數</span><strong>${escapeHtml(database.agent_task_count || 0)}</strong></div>
                <div class="metric-row"><span>訊號數</span><strong>${escapeHtml(database.agent_signal_count || 0)}</strong></div>
                <div class="metric-row"><span>任務通知</span><strong>${escapeHtml(database.agent_notification_count || 0)}</strong></div>
                <div class="metric-row"><span>CNS 心跳</span><strong>${database.heartbeat_enabled ? escapeHtml(database.cns_heartbeat_count || 0) : '已停用'}</strong></div>
            `;
        }

        async function runCycleNow() {
            runCycleBtn.disabled = true;
            runCycleBtn.textContent = '執行中...';
            try {
                const response = await fetch('/system/cns/run-cycle', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                const data = await response.json();
                const tasks = Array.isArray(data.processed_tasks) ? data.processed_tasks : [];
                const success = tasks.filter(item => String(item.status || '').toLowerCase() === 'completed').length;
                const failed = tasks.filter(item => String(item.status || '').toLowerCase() === 'failed').length;
                addMessage('ai', `CNS 已執行一輪巡檢：處理 ${tasks.length} 個任務，成功 ${success}，失敗 ${failed}。`);
                loadMonitorData(false);
            } catch (error) {
                addMessage('ai', '無法執行 CNS 巡檢。');
            } finally {
                runCycleBtn.disabled = false;
                runCycleBtn.textContent = '執行一輪';
            }
        }

        function startNewChat() {
            if (!confirm('確定要開始新對話嗎？這將清除當前聊天內容。')) return;
            chatBox.innerHTML = getWelcomeMarkup();
            bindModelCards();
            bindPromptChips();
            bindActionCards();
            syncModelCards();
            userInput.value = '';
            clearInputDraft();
            updateCharCount();
            autoResizeInput();
            toggleSendButton();
            setInputHint('總管會依關鍵詞與已學習訊號自動分派。');
        }

        function clearChat() {
            const messages = chatBox.querySelectorAll('.message');
            if (!messages.length) return;
            if (!confirm('確定要清除所有訊息嗎？')) return;
            startNewChat();
        }

        sendBtn.addEventListener('click', sendMessage);
        userInput.addEventListener('keydown', (event) => {
            if (event.key === 'Enter' && !event.shiftKey && !event.isComposing) {
                event.preventDefault();
                sendMessage();
            }
        });
        userInput.addEventListener('input', () => {
            updateCharCount();
            autoResizeInput();
            saveInputDraft();
            toggleSendButton();
        });
        modelSelect.addEventListener('change', () => {
            syncModelCards();
            if (isWelcomeVisible()) {
                enterConversationMode();
            }
        });
        historyBtn.addEventListener('click', () => {
            openHistorySidebar();
            showHistory();
        });
        statusBtn.addEventListener('click', () => loadMonitorData(true));
        monitorBtn.addEventListener('click', () => loadMonitorData(true));
        closeHistoryBtn.addEventListener('click', closePanels);
        closeMonitorBtn.addEventListener('click', closePanels);
        overlay.addEventListener('click', closePanels);
        newChatBtn.addEventListener('click', startNewChat);
        clearChatBtn.addEventListener('click', clearChat);
        learnBtn.addEventListener('click', startLearning);
        refreshMonitorBtn.addEventListener('click', () => loadMonitorData(false));
        runCycleBtn.addEventListener('click', runCycleNow);
        runCycleBtnSecondary.addEventListener('click', runCycleNow);
        monitorTabs.forEach(tab => {
            tab.addEventListener('click', () => setActiveMonitorTab(tab.dataset.tab));
        });
        notificationBtn.addEventListener('click', async () => {
            await pullNotifications(true);
            await markAllNotificationsRead();
        });

        bindModelCards();
        bindPromptChips();
        bindActionCards();
        syncModelCards();
        renderQuickAgents(REQUIRED_AGENTS);
        setActiveMonitorTab('overview');
        restoreInputDraft();
        autoResizeInput();
        updateCharCount();
        toggleSendButton();
        checkStatus();
        loadMonitorData(false);
        pullNotifications(true);
        setInterval(() => {
            if (monitorSidebar.classList.contains('active')) {
                loadMonitorData(false);
            }
        }, 15000);
        setInterval(() => {
            pullNotifications(false);
        }, 4000);
    </script>
</body>
</html>
