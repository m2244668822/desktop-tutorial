# .env 環境變數範例
# 複製此檔案為 .env，然後填入您的 API Keys

# ============ AI 模型 API Keys ============

# Gemini (Google) - 免費額度充足
# 取得方式: https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI (GPT) - 需付費
# 取得方式: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Claude (Anthropic) - 有限免費額度
# 取得方式: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# xAI (Grok) - 需付費
# 取得方式: https://console.x.ai/
XAI_API_KEY=your_xai_api_key_here

# ============ Ollama 設定 ============
# Ollama 本地服務 URL（預設為 localhost:11434）
# OLLAMA_URL=http://localhost:11434/api/chat

# ============ 自訂 API 設定 ============
# 如果您有其他 OpenAI 相容的 API
# CUSTOM_API_URL=https://your-custom-api.com/v1/chat/completions
# CUSTOM_API_KEY=your_custom_api_key
# CUSTOM_API_MODEL=your-model-name
