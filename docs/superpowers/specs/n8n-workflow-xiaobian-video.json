{
  "id": "xiaobianVideo001",
  "name": "Xiaobian Short Video Automation",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "video-script",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "responseData": "accepted",
        "options": {}
      },
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "model": "gemini-1.5-flash",
        "prompt": "={{$json.body.script}}",
        "systemInstruction": "You are Xiaobian, a master short video designer. Parse this script into structured scenes with visual prompts and TTS text. Output JSON.",
        "options": {}
      },
      "name": "Gemini Parser",
      "type": "n8n-nodes-base.googleGemini",
      "typeVersion": 1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "prompt": "={{$json.visual_prompt}}",
        "model": "dall-e-3",
        "size": "1024x1792"
      },
      "name": "DALL-E 3 Generator",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [650, 200]
    },
    {
      "parameters": {
        "text": "={{$json.text}}",
        "voice": "onyx",
        "model": "tts-1"
      },
      "name": "OpenAI TTS",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [650, 400]
    },
    {
      "parameters": {
        "executeOnce": true,
        "command": "node -e \"const fs=require('fs'),path=require('path'),cp=require('child_process');const root=process.env.XIAOBIAN_VIDEO_OUTPUT_DIR||path.join(process.cwd(),'data','generated','xiaobian-video');fs.mkdirSync(root,{recursive:true});const image=path.join(root,'image.png'),audio=path.join(root,'audio.mp3'),output=path.join(root,'output-'+Date.now()+'.mp4');for(const f of [image,audio]){if(!fs.existsSync(f)){throw new Error('missing input '+f)}}const args=['-y','-loop','1','-i',image,'-i',audio,'-c:v','libx264','-tune','stillimage','-c:a','aac','-shortest','-pix_fmt','yuv420p',output];const r=cp.spawnSync('ffmpeg',args,{stdio:'inherit'});if(r.status)process.exit(r.status);console.log(JSON.stringify({output}));\""
      },
      "name": "FFmpeg Assembly",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [850, 300]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [[{ "node": "Gemini Parser", "type": "main", "index": 0 }]]
    },
    "Gemini Parser": {
      "main": [
        [{ "node": "DALL-E 3 Generator", "type": "main", "index": 0 }],
        [{ "node": "OpenAI TTS", "type": "main", "index": 0 }]
      ]
    },
    "DALL-E 3 Generator": {
      "main": [[{ "node": "FFmpeg Assembly", "type": "main", "index": 0 }]]
    },
    "OpenAI TTS": {
      "main": [[{ "node": "FFmpeg Assembly", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionTimeout": 900,
    "saveExecutionProgress": true,
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "none"
  },
  "staticData": null,
  "pinData": {},
  "versionId": "4d0e84c8-bc45-4679-a79e-56e025dc582a",
  "meta": {
    "source": "docs/superpowers/specs/n8n-workflow-xiaobian-video.json",
    "status": "draft-import",
    "notes": "Imported as inactive draft; credentials, webhook header auth credential, FFmpeg binary, and first controlled execution still need verification before activation.",
    "cost_controls": {
      "max_script_chars": 6000,
      "max_image_generations_per_run": 12,
      "max_tts_chars_per_run": 12000,
      "paid_provider_nodes": ["Gemini Parser", "DALL-E 3 Generator", "OpenAI TTS"],
      "activation_requires_manual_review": true
    },
    "error_policy": {
      "default": "fail_closed",
      "store_failed_execution": true,
      "manual_retry_only_until_first_success": true,
      "notify_agent_task_board": true
    },
    "runtime_contract": {
      "output_dir_env": "XIAOBIAN_VIDEO_OUTPUT_DIR",
      "default_output_dir": "data/generated/xiaobian-video",
      "required_inputs": ["image.png", "audio.mp3"],
      "final_output_pattern": "output-<timestamp>.mp4"
    }
  }
}
