# Trevor local runtime. Keep private runtime data outside the repository.
TREVOR_DEPLOYMENT=mac
TREVOR_DATA_DIR="$HOME/Library/Application Support/Trevor"
TREVOR_MEMORY_ENCRYPTION=required
TREVOR_API_AUTH_REQUIRED=false
APP_DATA_ROOT="$HOME/Library/Application Support/Trevor"
APP_INSTANCE_DIR="$HOME/Library/Application Support/Trevor/instance"
APP_UPLOAD_DIR="$HOME/Library/Application Support/Trevor/uploads"
APP_LOG_DIR="$HOME/Library/Logs/Trevor"
APP_ARCHIVE_DIR="$HOME/Library/Application Support/Trevor/archive"
APP_DATABASE_PATH="$HOME/Library/Application Support/Trevor/instance/chat_history.db"

# Provider secrets live in Keychain service `trevor.providers`.
# On Windows, the same service/account pair is stored in Credential Manager.
# Accounts use `<provider>-api-key`; never place API keys in this file.
# Obtain keys only from each provider's official website.
# macOS: `security add-generic-password -a gemini-api-key -s trevor.providers -w "$KEY" -U`
# Check status without printing a secret: `security find-generic-password -a gemini-api-key -s trevor.providers >/dev/null && echo configured || echo missing`
# Windows PowerShell: use Credential Manager target `trevor.providers/gemini-api-key`.
# After changing credentials, restart Trevor. Do not paste keys into chat or `.env`.
TREVOR_PROVIDER_KEYCHAIN_SERVICE=trevor.providers
TREVOR_DELIBERATION_ROLLOUT=shadow
NVIDIA_CONTROL_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_CODING_MODEL=poolside/laguna-xs-2.1
NVIDIA_GENERAL_BACKUP_MODEL=z-ai/glm-5.2
GEMINI_MODEL=gemini-3.7-flash
GROQ_MODEL=openai/gpt-oss-120b
CEREBRAS_MODEL=zai-glm-4.7
OPENROUTER_FREE_MODEL=openrouter/free
CLOUDFLARE_PLAN=free
TREVOR_GEMINI_FREE_TIER_CONFIRMED=true
TREVOR_GROQ_FREE_TIER_CONFIRMED=true
TREVOR_CEREBRAS_FREE_TIER_CONFIRMED=false
TREVOR_OPENROUTER_FREE_TIER_CONFIRMED=false
TREVOR_CLOUDFLARE_FREE_TIER_CONFIRMED=false

# Private Graphiti sidecar.
TREVOR_GRAPHITI_HOST=127.0.0.1
TREVOR_GRAPHITI_PORT=8091
TREVOR_GRAPHITI_GRAPH=trevor
TREVOR_GRAPHITI_QUERY_CONCURRENCY=1
TREVOR_GRAPHITI_EXTRACTION_MODEL=gemini-3.7-flash
TREVOR_GRAPHITI_RERANK_MODEL=gemini-3.5-flash-lite
TREVOR_GRAPHITI_EMBEDDING_MODEL=nomic-embed-text
TREVOR_OLLAMA_BASE_URL=http://127.0.0.1:11434
TREVOR_WEB_SEARCH_ENABLED=true
TREVOR_WEB_SEARCH_ENDPOINT=https://html.duckduckgo.com/html/

# AI Horde reads its API key only from Keychain service `perob.ai-horde`.
AI_HORDE_ENABLED=true
AI_HORDE_API_BASE=https://stablehorde.net/api
AI_HORDE_CLIENT_AGENT=Trevor:1.0:local-client
AI_HORDE_KEYCHAIN_SERVICE=perob.ai-horde
AI_HORDE_KEYCHAIN_ACCOUNT=api-key
AI_HORDE_CONNECT_TIMEOUT_SECONDS=10
AI_HORDE_REQUEST_TIMEOUT_SECONDS=30
AI_HORDE_JOB_TIMEOUT_SECONDS=600
AI_HORDE_MAX_CONCURRENT_JOBS=2
AI_HORDE_MAX_QUEUED_JOBS=8

STARTUP_BOOTSTRAP_ENABLED=false
ENABLE_DAILY_AUTONOMOUS_JOBS=false
CNS_HEARTBEAT_ENABLED=false

# Mac Edge Client must target a private Tailscale hostname or IP.
TREVOR_EDGE_REMOTE_URL=https://trevor.example-tailnet.ts.net
